				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}
	set AppleScript's text item delimiters to linefeed
	set msg to (input as text)
	if msg is not "" then
		activate
		if msg starts with "Wacom driver restarted" then
			display alert "Wacom Restart Driver" message msg
		else
			display alert "Wacom Restart Driver" message msg as critical
		end if
	end if
	return input
end run</string>
